vunit i_dispatcher_jobs(dispatcher_jobs(rtl))
{
   -- The number of jobs in a picture
   constant C_NUM_JOBS : natural := G_NUM_ROWS * C_NUM_BLOCKS;

   -- The bits of a column number in the picture
   constant C_COL_BITS : natural := log2(G_NUM_COLS) + 1;

   -- The job module given each job, as a one-hot vector
   signal f_tbl_sel     : std_logic_vector(G_NUM_ITERATORS-1 downto 0);

   -- The same, and the picture row and the block of the job, one clock
   -- cycle later, i.e. when the job module is started
   signal f_tbl_sel_d   : std_logic_vector(G_NUM_ITERATORS-1 downto 0);
   signal f_tbl_row_d   : std_logic_vector(C_ROW_BITS-1 downto 0);
   signal f_tbl_blk_d   : natural range 0 to C_NUM_BLOCKS-1;

   -- The picture, as given at the start (start_i)
   signal f_startx      : std_logic_vector(C_VALUE_BITS-1 downto 0);
   signal f_starty      : std_logic_vector(C_VALUE_BITS-1 downto 0);
   signal f_stepx       : std_logic_vector(C_VALUE_BITS-1 downto 0);
   signal f_stepy       : std_logic_vector(C_VALUE_BITS-1 downto 0);

   -- A picture has been started since the reset
   signal f_started     : std_logic;

   -- The number of jobs given out in this picture, and the block and the
   -- picture row of the next job
   signal f_jobs        : natural range 0 to C_NUM_JOBS;
   signal f_blk         : natural range 0 to C_NUM_BLOCKS-1;
   signal f_row         : natural range 0 to G_NUM_ROWS;

   -- The value of c of the job started in this clock cycle, i.e. of the
   -- picture row and the block in f_tbl_row_d and f_tbl_blk_d
   signal f_cx          : std_logic_vector(C_VALUE_BITS-1 downto 0);
   signal f_cy          : std_logic_vector(C_VALUE_BITS-1 downto 0);

   -- For each job module: Its group has the value of c of the job started in
   -- this clock cycle
   signal f_job_c       : std_logic_vector(G_NUM_ITERATORS-1 downto 0);

   -- The reset of the last two clock cycles
   signal f_rst_d       : std_logic;
   signal f_rst_dd      : std_logic;

   -- The job modules are being reset. Their reset (job_rst_o) is rst_i
   -- delayed by one clock cycle, and they register it again.
   signal f_job_in_rst  : std_logic;

   -- For each group of job modules: The reset (job_rst_o) of the last two
   -- clock cycles
   signal f_job_rst_d   : std_logic_vector(C_NUM_GROUPS-1 downto 0);
   signal f_job_rst_dd  : std_logic_vector(C_NUM_GROUPS-1 downto 0);

   -- The number of clock cycles all the jobs have been given out and all the
   -- job modules idle, without the picture being done
   constant C_MAX_IDLE  : natural := 2;
   signal f_idle        : natural range 0 to C_MAX_IDLE+1;

   -- At most one job module is started
   signal f_one_start   : std_logic;

   -- Invariants of the internal state, computed below
   signal f_state_next  : std_logic;
   signal f_state_job   : std_logic;
   signal f_state_c     : std_logic;


   -- set all declarations to run on clk_i
   default clock is rising_edge(clk_i);


   f_tbl_gen : for i in 0 to G_NUM_ITERATORS-1 generate
      f_tbl_sel(i) <= '1' when tbl_valid_o = '1' and tbl_idx_o = i else '0';
   end generate f_tbl_gen;

   p_one_start : process (all)
      variable cnt_v : natural;
   begin
      cnt_v := 0;
      for i in 0 to G_NUM_ITERATORS-1 loop
         if job_start_o(i) = '1' then
            cnt_v := cnt_v + 1;
         end if;
      end loop;
      if cnt_v <= 1 then f_one_start <= '1'; else f_one_start <= '0'; end if;
   end process p_one_start;

   p_delay : process (clk_i)
   begin
      if rising_edge(clk_i) then
         f_tbl_sel_d  <= f_tbl_sel;
         f_tbl_row_d  <= tbl_row_o;
         f_tbl_blk_d  <= tbl_blk_o;
         f_job_rst_d  <= job_rst_o;
         f_job_rst_dd <= f_job_rst_d;
         f_rst_d      <= rst_i;
         f_rst_dd     <= f_rst_d;
      end if;
   end process p_delay;

   f_job_in_rst <= rst_i or f_rst_d or f_rst_dd;

   p_picture : process (clk_i)
   begin
      if rising_edge(clk_i) then
         if tbl_valid_o = '1' and f_jobs < C_NUM_JOBS then
            f_jobs <= f_jobs + 1;
            if f_blk < C_NUM_BLOCKS-1 then
               f_blk <= f_blk + 1;
            else
               f_blk <= 0;
               f_row <= f_row + 1;
            end if;
         end if;

         if start_i = '1' then
            f_startx  <= startx_i;
            f_starty  <= starty_i;
            f_stepx   <= stepx_i;
            f_stepy   <= stepy_i;
            f_started <= '1';
            f_jobs    <= 0;
            f_blk     <= 0;
            f_row     <= 0;
         end if;

         if rst_i = '1' then
            f_started <= '0';
            f_jobs    <= 0;
            f_blk     <= 0;
            f_row     <= 0;
         end if;
      end if;
   end process p_picture;

   p_c : process (all)
      variable prod_x_v : std_logic_vector(C_COL_BITS+C_VALUE_BITS-1 downto 0);
      variable prod_y_v : std_logic_vector(C_ROW_BITS+C_VALUE_BITS-1 downto 0);
   begin
      prod_x_v := to_slv(f_tbl_blk_d * G_COLS_IN_JOB, C_COL_BITS) * f_stepx;
      prod_y_v := f_tbl_row_d * f_stepy;
      f_cx     <= f_startx + prod_x_v(C_VALUE_BITS-1 downto 0);
      f_cy     <= f_starty + prod_y_v(C_VALUE_BITS-1 downto 0);
   end process p_c;

   f_job_c_gen : for i in 0 to G_NUM_ITERATORS-1 generate
      f_job_c(i) <= '1' when job_startx_o(i / G_GROUP_SIZE) = f_cx and
                             job_cy_o(i / G_GROUP_SIZE)     = f_cy and
                             job_stepx_o(i / G_GROUP_SIZE)  = f_stepx else '0';
   end generate f_job_c_gen;

   p_idle : process (clk_i)
   begin
      if rising_edge(clk_i) then
         if f_jobs = C_NUM_JOBS and job_busy_i = 0 and job_start_o = 0 and
            done_o = '0' and start_i = '0' then
            if f_idle <= C_MAX_IDLE then
               f_idle <= f_idle + 1;
            end if;
         else
            f_idle <= 0;
         end if;

         if rst_i = '1' then
            f_idle <= 0;
         end if;
      end if;
   end process p_idle;

   p_state : process (all)
      variable blk_v    : natural;
      variable row_v    : natural;
      variable prod_x_v : std_logic_vector(C_COL_BITS+C_VALUE_BITS-1 downto 0);
      variable prod_y_v : std_logic_vector(C_ROW_BITS+1+C_VALUE_BITS-1 downto 0);
      variable prod_b_v : std_logic_vector(2*C_VALUE_BITS-1 downto 0);
   begin
      -- The block and the picture row of the next job, in cur_blk_r and
      -- cur_row_r. When a job is in tbl_*_o, they are already those of the
      -- job after it. Before the first picture, no job has been given out,
      -- and the scheduler is not active.
      blk_v := f_blk;
      row_v := f_row;
      if tbl_valid_o = '1' then
         if blk_v < C_NUM_BLOCKS-1 then
            blk_v := blk_v + 1;
         else
            blk_v := 0;
            row_v := row_v + 1;
         end if;
      end if;
      f_state_next <= '0';
      if cur_blk_r = blk_v and cur_row_r = row_v and
         f_jobs = f_row*C_NUM_BLOCKS + f_blk and f_blk < C_NUM_BLOCKS and
         (f_row < G_NUM_ROWS or (f_row = G_NUM_ROWS and f_blk = 0)) and
         (f_started = '1' or (f_jobs = 0 and sched_active_r = '0')) then
         f_state_next <= '1';
      end if;

      -- The job in tbl_*_o is the one that was started
      f_state_job <= '0';
      if (job_start_r = 0) = (job_started_r = '0') and
         job_start_r = f_tbl_sel and
         (job_wrap_r = '1') = (tbl_valid_o = '1' and f_blk = C_NUM_BLOCKS-1) then
         f_state_job <= '1';
      end if;

      -- The value of c in job_startx_r and job_cy_r is that of the block and
      -- the picture row in f_blk and f_row, and the picture in the other
      -- registers is the one of the start
      prod_x_v  := to_slv(f_blk * G_COLS_IN_JOB, C_COL_BITS) * f_stepx;
      prod_y_v  := to_slv(f_row, C_ROW_BITS+1) * f_stepy;
      prod_b_v  := f_stepx * to_slv(G_COLS_IN_JOB, C_VALUE_BITS);
      f_state_c <= '0';
      if job_startx_r = f_startx + prod_x_v(C_VALUE_BITS-1 downto 0) and
         job_cy_r     = f_starty + prod_y_v(C_VALUE_BITS-1 downto 0) and
         job_leftx_r  = f_startx and job_stepx_r = f_stepx and
         job_stepy_r  = f_stepy and job_blk_stepx_r = prod_b_v(C_VALUE_BITS-1 downto 0) then
         f_state_c <= '1';
      end if;
   end process p_state;


   -----------------------------
   -- ASSERTIONS ABOUT THE JOBS
   -----------------------------

   -- No job is given out right after reset
   f_after_reset : assert always {rst_i} |=> {not tbl_valid_o};

   -- The jobs of a picture are given out in order, one picture row at a
   -- time, each once: First all the blocks of the top row, from left to
   -- right, then all the blocks of the next row, and so on. Nothing is given
   -- out before the first picture.
   f_jobs_order : assert always {tbl_valid_o and not rst_i} |->
      {f_started = '1' and f_jobs < C_NUM_JOBS and
       to_integer(tbl_row_o) = f_row and tbl_blk_o = f_blk};

   -- The job module given the job is started in the next clock cycle, and
   -- only then
   f_start_one : assert always {not rst_i} |-> {f_one_start};
   f_start_tbl : assert always {not rst_i} |-> {job_start_o = f_tbl_sel_d};

   -- The job module is started with the value of c of the first column of
   -- its job, and the step in cx of the picture
   f_job_c_gen_a : for i in 0 to G_NUM_ITERATORS-1 generate
      f_job_c_a : assert always {job_start_o(i) and not rst_i} |-> {f_job_c(i)};
   end generate f_job_c_gen_a;

   -- The picture is done only when all its jobs have been given out, and all
   -- the job modules are idle, and it stays done until the next start
   f_done_jobs   : assert always {done_o and not rst_i} |->
      {f_started = '1' and f_jobs = C_NUM_JOBS and job_busy_i = 0 and job_start_o = 0};
   f_done_stable : assert always {done_o and not start_i and not rst_i} |=> {done_o};

   -- The picture is done within C_MAX_IDLE clock cycles after all its jobs
   -- have been given out, and all the job modules are idle. The bound is
   -- reached, see f_max_idle.
   f_done_idle   : assert always {not rst_i} |-> {f_idle <= C_MAX_IDLE};


   -----------------------------
   -- ASSERTIONS ABOUT THE JOB MODULES
   -----------------------------

   -- These are the assumptions about the inputs of the job module in job_wide.psl.
   -- They are not checked while the job modules are being reset, when the
   -- properties in job_wide.psl are not checked either.
   f_job_gen : for i in 0 to G_NUM_ITERATORS-1 generate
      -- A job module is only started when it is idle, i.e. a job is never
      -- started twice. This needs at least five job modules.
      f_job_idle   : assert always {job_start_o(i) and not f_job_in_rst} |-> {not job_busy_i(i)};

      -- A job module is not started in the clock cycle after its reset. The
      -- reset of the job modules is rst_i delayed by one clock cycle, and the
      -- first clock cycle is left out, because the reset has not reached
      -- job_rst_o yet.
      f_job_rst    : assert always {rst_i; job_rst_o(i / G_GROUP_SIZE)} |=> {not job_start_o(i)};

      -- The step in cx does not change while the job module is busy
      f_job_stepx  : assert always {job_busy_i(i) and not job_start_o(i) and not f_job_in_rst} |->
         {stable(job_stepx_o(i / G_GROUP_SIZE))};
   end generate f_job_gen;

   -- The reset of the job modules lasts at least two clock cycles
   f_job_rst_gen : for g in 0 to C_NUM_GROUPS-1 generate
      f_job_rst_long : assert always {not job_rst_o(g); job_rst_o(g)} |=> {job_rst_o(g)};
   end generate f_job_rst_gen;


   -----------------------------
   -- ASSERTIONS ABOUT INTERNAL STATE
   -----------------------------

   -- These are needed for the induction
   f_state_next_a : assert always {not rst_i} |-> {f_state_next};
   f_state_job_a  : assert always {not rst_i} |-> {f_state_job};

   -- Before the first picture, all the job modules are idle, after their
   -- reset
   f_state_first  : assert always {not f_started and not f_job_in_rst} |->
      {job_busy_i = 0 and job_start_o = 0};

   -- job_blk_stepx_r is calculated two clock cycles after the start, so it
   -- is not checked in the clock cycle after the start
   f_state_c_a    : assert always {f_started and not start_i and not prev(start_i) and not rst_i} |->
      {f_state_c};


   -----------------------------
   -- ASSUMPTIONS ABOUT INPUTS
   -----------------------------

   -- Require reset at startup. The reset lasts at least two clock cycles.
   f_reset      : assume {rst_i; rst_i};
   f_reset_long : assume always {not rst_i; rst_i} |=> {rst_i};

   -- A picture is only started after the reset, or when the previous picture
   -- is done, as in main.vhd. A start while the jobs are being given out
   -- would go wrong: A job given out in the same clock cycle would get the
   -- first value of cx of the new picture, but keep its block, and all the
   -- following jobs would get the value of cx of the block after their own.
   f_start_idle : assume always {start_i and f_started} |-> {done_o};

   -- The job modules, see job_wide.psl: A job module is busy in the clock cycle
   -- after it is started. It only becomes busy when it is started, and it is
   -- idle two clock cycles after its reset (it registers the reset first).
   -- It becomes idle at any time.
   f_busy_gen : for i in 0 to G_NUM_ITERATORS-1 generate
      f_busy_start : assume always {job_start_o(i)} |=> {job_busy_i(i)};
      f_busy_only  : assume always {not job_busy_i(i) and not job_start_o(i)} |=> {not job_busy_i(i)};
      f_busy_rst   : assume always {f_job_rst_dd(i / G_GROUP_SIZE)} |-> {not job_busy_i(i)};
   end generate f_busy_gen;


   --------------------------------------------
   -- COVER STATEMENTS TO VERIFY REACHABILITY
   --------------------------------------------

   -- A picture is done, and the next picture is started
   f_done : cover {done_o and f_started and not rst_i};
   f_next : cover {start_i and done_o and f_started and not rst_i};

   -- The picture is done as late as allowed by f_done_idle
   f_max_idle : cover {f_idle = C_MAX_IDLE and rst_i = '0'};

   -- A job module is given a second job in the same picture
   f_reuse : cover {tbl_valid_o = '1' and f_jobs >= G_NUM_ITERATORS and rst_i = '0'};

} -- vunit i_dispatcher_jobs(dispatcher_jobs(rtl))
