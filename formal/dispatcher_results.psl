vunit i_dispatcher_results(dispatcher_results(rtl))
{
   -- The number of words of a job module's result
   constant C_DATA_BITS : natural := 9*G_PIXELS;

   type f_col_vector is array (natural range <>) of std_logic_vector(C_COL_BITS-1 downto 0);
   type f_blk_vector is array (natural range <>) of natural range 0 to C_NUM_BLOCKS-1;
   type f_data_vector is array (natural range <>) of std_logic_vector(C_DATA_BITS-1 downto 0);

   -- The picture column and the block of the job of each job module, as
   -- given by dispatcher_jobs (tbl_*_i), and whether it has had a job
   signal f_col        : f_col_vector(G_NUM_ITERATORS-1 downto 0);
   signal f_blk        : f_blk_vector(G_NUM_ITERATORS-1 downto 0);
   signal f_has_job    : std_logic_vector(G_NUM_ITERATORS-1 downto 0) := (others => '0');

   -- The result of each job module (the slice of res_data_i)
   signal f_res_data   : f_data_vector(G_NUM_ITERATORS-1 downto 0);

   -- The job module selected by i_res_scheduler in this clock cycle, as a
   -- one-hot vector, and in the last two clock cycles. A selected job module
   -- is acknowledged two clock cycles later.
   signal f_sel        : std_logic_vector(G_NUM_ITERATORS-1 downto 0);
   signal f_sel_d      : std_logic_vector(G_NUM_ITERATORS-1 downto 0) := (others => '0');
   signal f_sel_dd     : std_logic_vector(G_NUM_ITERATORS-1 downto 0) := (others => '0');

   -- The write expected for the acknowledge of this clock cycle (the
   -- address from the table and the row of the result, and the counts of
   -- the result), one and two clock cycles later
   signal f_exp_en_d   : std_logic := '0';
   signal f_exp_addr_d : std_logic_vector(G_ADDR_BITS-1 downto 0);
   signal f_exp_data_d : std_logic_vector(C_DATA_BITS-1 downto 0);
   signal f_exp_en_dd  : std_logic := '0';
   signal f_exp_addr_dd : std_logic_vector(G_ADDR_BITS-1 downto 0);
   signal f_exp_data_dd : std_logic_vector(C_DATA_BITS-1 downto 0);

   -- The number of acknowledges in this clock cycle is at most one
   signal f_one_ack    : std_logic;

   -- Clock cycles since the start, up to C_INIT. The pipeline has no reset,
   -- so the checks start when the reset at the start has flushed it.
   constant C_INIT     : natural := 6;
   signal f_init       : natural range 0 to C_INIT := 0;
   signal f_ready      : std_logic;


   -- set all declarations to run on clk_i
   default clock is rising_edge(clk_i);


   f_gen : for i in 0 to G_NUM_ITERATORS-1 generate
      f_sel(i)      <= '1' when idx_valid_r = '1' and idx_iterator_r = i else '0';
      f_res_data(i) <= res_data_i((i+1)*C_DATA_BITS-1 downto i*C_DATA_BITS);
   end generate f_gen;

   f_ready <= '1' when f_init = C_INIT else '0';

   p_one_ack : process (all)
      variable cnt_v : natural;
   begin
      cnt_v := 0;
      for i in 0 to G_NUM_ITERATORS-1 loop
         if res_ack_o(i) = '1' then
            cnt_v := cnt_v + 1;
         end if;
      end loop;
      if cnt_v <= 1 then f_one_ack <= '1'; else f_one_ack <= '0'; end if;
   end process p_one_ack;

   p_track : process (clk_i)
      variable en_v   : std_logic;
      variable addr_v : natural;
      variable data_v : std_logic_vector(C_DATA_BITS-1 downto 0);
   begin
      if rising_edge(clk_i) then
         if f_init < C_INIT then
            f_init <= f_init + 1;
         end if;

         if tbl_valid_i = '1' then
            f_col(tbl_idx_i)     <= tbl_col_i;
            f_blk(tbl_idx_i)     <= tbl_blk_i;
            f_has_job(tbl_idx_i) <= '1';
         end if;

         f_sel_d  <= f_sel;
         f_sel_dd <= f_sel_d;

         -- The write expected for the acknowledge
         en_v   := '0';
         addr_v := 0;
         data_v := (others => '0');
         for i in 0 to G_NUM_ITERATORS-1 loop
            if res_ack_o(i) = '1' then
               en_v   := '1';
               addr_v := to_integer(f_col(i))*G_COL_STRIDE + f_blk(i)*G_ROWS_IN_JOB +
                         to_integer(res_addr_i(i));
               data_v := f_res_data(i);
            end if;
         end loop;
         f_exp_en_d    <= en_v;
         f_exp_addr_d  <= to_slv(addr_v mod 2**G_ADDR_BITS, G_ADDR_BITS);
         f_exp_data_d  <= data_v;
         f_exp_en_dd   <= f_exp_en_d;
         f_exp_addr_dd <= f_exp_addr_d;
         f_exp_data_dd <= f_exp_data_d;
      end if;
   end process p_track;


   -----------------------------
   -- ASSERTIONS ABOUT THE RESULTS
   -----------------------------

   -- At most one job module is acknowledged in each clock cycle, and only
   -- one that has a result. The job module removes its result when it sees
   -- the acknowledge (see the assumptions below), so each result is
   -- acknowledged only once.
   f_ack_one : assert always {f_ready} |-> {f_one_ack};
   f_ack_gen : for i in 0 to G_NUM_ITERATORS-1 generate
      f_ack_valid : assert always {res_ack_o(i) and f_ready} |-> {res_valid_i(i)};
   end generate f_ack_gen;

   -- Each acknowledged result is written exactly once, two clock cycles after
   -- the acknowledge, to the address from the table (the picture column and
   -- the block of the job) and the row of the result, with the counts of the
   -- result. Nothing else is written.
   f_wr_en   : assert always {f_ready} |-> {wr_en_o = f_exp_en_dd};
   f_wr_addr : assert always {wr_en_o and f_ready} |-> {wr_addr_o = f_exp_addr_dd};
   f_wr_data : assert always {wr_en_o and f_ready} |-> {wr_data_o = f_exp_data_dd};

   -- The contract with i_res_scheduler (see res_scheduler.vhd): when a job
   -- module is selected in clock cycle c, its ready flag is low from clock
   -- cycle c+2 until it has a new result. The result is removed in clock
   -- cycle c+3, after the acknowledge, so the ready flag is checked in the
   -- clock cycles c+2 to c+4.
   f_ready_gen : for i in 0 to G_NUM_ITERATORS-1 generate
      f_ready_low : assert always {f_sel(i) and f_ready; true} |=> {not res_ready_s(i)[*3]};
   end generate f_ready_gen;


   -----------------------------
   -- ASSERTIONS ABOUT INTERNAL STATE
   -----------------------------

   -- The table holds the job of each job module that has had one. This is
   -- needed for the induction.
   f_tbl_gen : for i in 0 to G_NUM_ITERATORS-1 generate
      f_tbl_a : assert always {f_has_job(i)} |->
         {job_addr_r(i) = f_col(i) and job_blk_r(i) = f_blk(i)};
   end generate f_tbl_gen;


   -----------------------------
   -- ASSUMPTIONS ABOUT INPUTS
   -----------------------------

   -- Require reset at startup, long enough to flush the pipeline. A reset
   -- later on is not covered: the job modules are reset too, and lose their
   -- results without an acknowledge, which breaks the assumptions below (a
   -- result being acknowledged then may write any counts to any address, which
   -- does not matter, because the next picture overwrites them).
   f_reset      : assume {rst_i[*C_INIT]};
   f_reset_once : assume always {not rst_i} |=> {not rst_i};

   -- The job given by dispatcher_jobs is in range
   f_tbl_range  : assume always {tbl_valid_i} |->
      {to_integer(tbl_col_i) < G_NUM_COLS and tbl_idx_i < G_NUM_ITERATORS and
       tbl_blk_i < C_NUM_BLOCKS};

   -- The job modules, see job_wide.psl. A job module only has a result after it
   -- has been given a job. A result is the counts of G_PIXELS rows, starting
   -- at a row within the job that is a multiple of G_PIXELS. It stays
   -- unchanged until it is acknowledged, and is removed in the next clock
   -- cycle. A job module is only given a new job (which writes the table)
   -- when it has no result, and no acknowledge is on its way to it, i.e. not
   -- in the two clock cycles after it was selected (it is idle only after
   -- the acknowledge of its last result). Its first result comes later.
   f_job_gen : for i in 0 to G_NUM_ITERATORS-1 generate
      f_res_job    : assume always {not f_has_job(i)} |-> {not res_valid_i(i)};
      f_res_row    : assume always {res_valid_i(i)} |->
         {to_integer(res_addr_i(i)) < G_ROWS_IN_JOB and to_integer(res_addr_i(i)) mod G_PIXELS = 0};
      f_res_stable : assume always {res_valid_i(i) and not res_ack_o(i)} |=>
         {res_valid_i(i) = '1' and stable(res_addr_i(i)) and stable(f_res_data(i))};
      f_res_remove : assume always {res_ack_o(i)} |=> {not res_valid_i(i)};
      f_tbl_idle   : assume always {tbl_valid_i = '1' and tbl_idx_i = i} |->
         {res_valid_i(i) = '0' and f_sel(i) = '0' and f_sel_d(i) = '0' and f_sel_dd(i) = '0'};
      f_tbl_later  : assume always {tbl_valid_i = '1' and tbl_idx_i = i} |=> {not res_valid_i(i)};
   end generate f_job_gen;


   --------------------------------------------
   -- COVER STATEMENTS TO VERIFY REACHABILITY
   --------------------------------------------

   -- Results are written in two consecutive clock cycles. This needs more
   -- than one group, because i_res_scheduler visits each group at most once
   -- every five clock cycles.
   f_two_writes_gen : if C_NUM_GROUPS > 1 generate
      f_two_writes : cover {wr_en_o and f_ready; wr_en_o};
   end generate f_two_writes_gen;

   -- The last job module's result is written
   f_last : cover {res_ack_o(G_NUM_ITERATORS-1) and f_ready};

   -- A job module gets a second job after a result
   f_second_job : cover {f_ready = '1' and tbl_valid_i = '1' and f_has_job(tbl_idx_i) = '1'};

} -- vunit i_dispatcher_results(dispatcher_results(rtl))
