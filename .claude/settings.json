{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/claude-session-start.sh",
            "timeout": 900,
            "statusMessage": "Installing the simulation tools (only in the cloud environment)"
          }
        ]
      }
    ]
  }
}
